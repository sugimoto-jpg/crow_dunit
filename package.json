{
  "name": "tensei-arcana",
  "version": "1.0.0",
  "private": true,
  "description": "転生魔法学院譚 〜村人から始まる魔王討伐〜（依存ライブラリなしのブラウザRPG）",
  "scripts": {
    "lint": "node tools/lint-text.js",
    "test": "node tools/lint-text.js && node tools/globals.js && node tools/snapshot.js --check && node tools/test-rules.js && node tools/explore-test.js && node tools/smoke.js && node tools/journey-test.js && node tools/errors-test.js && node tools/strings.js && node tools/text-test.js && node tools/sprite-check.js --check && node tools/back-test.js && node tools/audio-test.js && node tools/voice-test.js && node tools/art-test.js && node tools/build-single.js && node tools/build-pwa.js && node tools/pwa-test.js && node tools/native-test.js && ENTRY=dist/tensei-arcana.html FILE=1 node tools/smoke.js && node tools/listeners.js",
    "test:rules": "node tools/test-rules.js",
    "art": "node tools/build-art.js",
    "test:art": "node tools/art-test.js",
    "test:voice": "node tools/voice-test.js",
    "test:explore": "node tools/explore-test.js",
    "test:journey": "node tools/journey-test.js",
    "test:errors": "node tools/errors-test.js",
    "test:back": "node tools/back-test.js",
    "test:audio": "node tools/audio-test.js",
    "music": "node tools/export-music.js",
    "strings": "node tools/strings.js",
    "unused": "node tools/unused.js",
    "mobile": "node tools/mobile-audit.js",
    "sprites": "node tools/sprite-sheet.js",
    "sprites:check": "node tools/sprite-check.js --check",
    "sprites:save": "node tools/sprite-check.js --save",
    "test:late": "node tools/smoke-late.js",
    "balance": "node tools/balance.js",
    "playthrough": "node tools/playthrough.js",
    "playthrough:easy": "DIFF=easy node tools/playthrough.js",
    "playthrough:hard": "DIFF=hard node tools/playthrough.js",
    "retune": "node tools/measure-party.js && node tools/retune-enemies.js",
    "build": "node tools/build-single.js",
    "build:pwa": "node tools/build-single.js && node tools/build-pwa.js",
    "icons": "node tools/make-icons.js",
    "test:pwa": "node tools/pwa-test.js",
    "test:native": "node tools/native-test.js",
    "icons:android": "node tools/make-android-icons.js",
    "cap:sync": "npm run build:pwa && npx cap sync",
    "deps": "node tools/deps.js",
    "snapshot": "node tools/snapshot.js --save",
    "verify": "node tools/snapshot.js --check && node tools/globals.js && node tools/deps.js",
    "globals": "node tools/globals.js",
    "listeners": "node tools/listeners.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "playwright": "^1.63.0"
  }
}
